# Copy to .env and adjust. All variables are optional; defaults are shown.
# Read by the FastAPI backend (apps/api) and passed on to worker subprocesses.

# Root for uploads, artifacts, and the SQLite job database.
SOCCERVISION_DATA_DIR=data
# Directory holding model checkpoints (never committed).
SOCCERVISION_WEIGHTS_DIR=models
# Let RF-DETR download missing pretrained COCO weights on first use.
SOCCERVISION_ALLOW_WEIGHT_DOWNLOAD=true

# Upload limits.
SOCCERVISION_MAX_UPLOAD_BYTES=524288000
SOCCERVISION_MAX_VIDEO_DURATION_SECONDS=600

# Job execution: number of concurrent worker subprocesses and dispatcher poll interval.
SOCCERVISION_MAX_CONCURRENT_JOBS=1
SOCCERVISION_DISPATCHER_POLL_SECONDS=1.0

# Analysis defaults (can be overridden per request).
# Detector: rfdetr-nano | rfdetr-small | rfdetr-medium
SOCCERVISION_DEFAULT_DETECTOR=rfdetr-nano
# Device: auto | cpu | mps | cuda  (auto prefers CUDA, then MPS, then CPU)
SOCCERVISION_DEFAULT_DEVICE=auto
SOCCERVISION_DEFAULT_CONFIDENCE_THRESHOLD=0.5
SOCCERVISION_DEFAULT_INFERENCE_STRIDE=1

# Comma-separated browser origins allowed by CORS.
SOCCERVISION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SOCCERVISION_LOG_LEVEL=INFO
